Dialogue: 0,0:15:38.43,0:15:42.22,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,naka naka naka naka naka naka naka naka taihen dakedo
Dialogue: 0,0:15:42.22,0:15:50.39,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,kanarazu getto da ze pokemon getto daze
Dialogue: 0,0:15:50.39,0:15:53.70,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,masara taun ni sayonara bye bye
Dialogue: 0,0:15:54.44,0:15:58.10,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,ore wa koitsu to tabi ni deru (Pikachu!)
Dialogue: 0,0:15:58.10,0:16:02.15,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,kitaeta waza de kachimakuri
Dialogue: 0,0:16:02.15,0:16:05.92,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,nakama o fuyashite tsugi no machi e
Dialogue: 0,0:16:05.92,0:16:09.91,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,itsumo itsu demo umaku yuku nante
Dialogue: 0,0:16:09.91,0:16:13.86,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,hoshou wa doko ni mo nai kedo (sorya sou ja!)
Dialogue: 0,0:16:13.86,0:16:23.21,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,itsu demo itsumo honki de ikiteru koitsu tachi ga iru
Dialogue: 0,0:16:27.99,0:16:32.31,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,tatoe hi no naka mizu no naka kusa no naka mori no naka
Dialogue: 0,0:16:32.31,0:16:36.29,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,tsuchi no naka kumo no naka ano ko no sukaato no naka (shitsukoi!)
Dialogue: 0,0:16:36.29,0:16:39.60,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,naka naka naka naka naka naka naka naka taihen dakedo
Dialogue: 0,0:16:40.06,0:16:48.28,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,kanarazu getto da ze pokemon getto daze
Dialogue: 0,0:16:48.28,0:16:51.44,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,tatakai tsukarete oyasumi good night
Dialogue: 0,0:16:52.16,0:16:55.96,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,mabuta o tojireba yomigaeru (Pikachu?)
Dialogue: 0,0:16:55.96,0:16:59.91,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,honoo ga moete kaze ga mai
Dialogue: 0,0:16:59.91,0:17:03.46,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,nakigoe todoroku ano batoru ga
Dialogue: 0,0:17:03.46,0:17:07.74,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,kinou no teki wa kyou no tomo tte
Dialogue: 0,0:17:07.74,0:17:11.65,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,furui kotoba ga aru kedo (furui to wa nan ja!)
Dialogue: 0,0:17:11.65,0:17:22.02,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,kyou no tomo wa ashita no tomodachi sou sa eien ni
Dialogue: 0,0:17:26.17,0:17:33.00,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,aa akogare no pokemon masutaa ni
Dialogue: 0,0:17:33.76,0:17:43.15,OPRomaji,Mezase Pokémon Master Kara,0,0,0,,naritai na naranakucha zettai natte yaru
